	fragment@52 {
		target = <&spi6>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default", "gt9896s_int_active", "gt9896s_reset_active", "gt9896s_int_suspend", "gt9896s_reset_suspend", "gt9896s_spi_mode";
			pinctrl-0 = <&ctp_gt9896s_pins_default>;
			pinctrl-1 = <&ctp_gt9896s_int_active>;
			pinctrl-2 = <&ctp_gt9896s_reset_active>;
			pinctrl-3 = <&ctp_gt9896s_int_suspend>;
			pinctrl-4 = <&ctp_gt9896s_reset_suspend>;
			pinctrl-5 = <&ctp_gt9896s_spi_mode>;

			goodix@0 {
				compatible = "novatek,NVT-ts-spi", "goodix,gt9896s", "goodix,nottingham", "st,spi";
				reg = <0x00>;
				spi-max-frequency = <0xf4240>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_spi_mode";
				pinctrl-0 = <&ts_st_reset_active>, <&ts_st_int_active>;
				pinctrl-1 = <&ts_st_int_suspend>, <&ts_st_reset_suspend>;
				pinctrl-2 = <&ts_st_spi_mode>;
				novatek,reset-gpio = <&pio>, <0x03 0x00>;
				novatek,irq-gpio = <&pio>, <0x04 0x00>;
				novatek,swrst-n8-addr = <0x3f0fe>;
				novatek,spi-rd-fast-addr = <0x3f310>;
				goodix,avdd-name = "vtouch";
				vtouch-supply = <&mt6373_vtp>;
				goodix,reset-gpio = <&pio>, <0x03 0x00>;
				goodix,irq-gpio = <&pio>, <0x04 0x00>;
				goodix,irq-flags = <0x02>;
				goodix,panel-max-id = <0x0a>;
				goodix,panel-max-x = <0x438>;
				goodix,panel-max-y = <0x960>;
				goodix,panel-max-w = <0x100>;
				goodix,panel-max-p = <0x100>;
				goodix,input-max-x = <0x438>;
				goodix,input-max-y = <0x960>;
				gt9895,power-voltage = <0x2ab980>;
				goodix,panel-key-map = <0x9e 0xac 0xd9>;
				goodix,power-on-delay-us = <0x2710>;
				goodix,power-off-delay-us = <0x1388>;
				gt9895,firmware-name = "gt9895_firmware_6989v01.bin";
				gt9895,config-name = "gt9895_cfg_6989v01.bin";
				goodix,firmware-version = "6983v01";
				goodix,config-version = "6983v01";
				goodix,x2x;
				goodix,y2y;
				goodix,pen-enable;
				tpd-filter-enable = <0x00>;
				tpd-filter-pixel-density = <0xa1>;
