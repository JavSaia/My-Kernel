	fragment@140 {
		target = <&i2c1>;

		__overlay__ {
			pinctrl-names = "i2c-state", "output-low-state";
			pinctrl-0 = <&i2c1_i2c_state>;
			pinctrl-1 = <&i2c1_output_low_state>;
		};
	};

	fragment@141 {
		target = <&pio>;

		__overlay__ {

			i2c1_i2c_state: i2c1_sda_i2c_state {
				phandle = <0xc9>;

				pins_cmd_dat {
					pinmux = <0x6401 0x6501>;
					bias-disable;
				};
			};

			i2c1_output_low_state: i2c1_sda_output_low_state {
				phandle = <0xca>;

				pins_cmd_dat {
					pinmux = <0x6400 0x6500>;
					output-low;
				};
			};
		};
	};

	fragment@142 {
		target = <&i2c13>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			oplus_sc8547_slave: sc8547-charger-slave@6A {
				status = "okay";
				compatible = "oplus,sc8547d";
				reg = <0x6a>;
				ocp_reg = <0x0e>;
				ovp_reg = <0x36>;
				oplus,use_slave_cp;
				vbus_ovp_reg = [5a];
				oplus_spec,irq_gpio = <&pio>, <0xc8 0x00>;
				interrupt-parent = <&pio>;
				interrupts = <0xc8 0x00>;
				pinctrl-names = "charging_inter_active", "charging_inter_sleep";
				pinctrl-0 = <&slave_charging_inter_active>;
				pinctrl-1 = <&slave_charging_inter_active>;
				phandle = <0x13a>;

				oplus_sc8547_slave_cp: oplus,sc8547_slave_cp {
					oplus,ic_type = <0x14>;
					oplus,ic_index = <0x01>;
					phandle = <0xbf>;
				};
			};
		};
	};

	fragment@143 {
		target = <&i2c5>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			byb_tps6128xd: byb-tps6128xd@75 {
				status = "okay";
				compatible = "oplus,byb-tps6128xd";
				reg = <0x75>;
				oplus,ic_type = <0x01>;
				oplus,ic_index = <0x00>;
				oplus,vout-mv = <0xd16>;
				oplus,ilim-ma = <0x1194>;
				phandle = <0xaf>;
