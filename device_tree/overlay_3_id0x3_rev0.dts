					remote-endpoint = <&tcpc_typec_usb>;
					phandle = <0x29>;
				};
			};
		};
	};

	fragment@34 {
		target = <&ps5170>;

		__overlay__ {
			pinctrl-names = "enable", "disable";
			pinctrl-0 = <&ps_enable>;
			pinctrl-1 = <&ps_disable>;
			status = "okay";
		};
	};

	fragment@35 {
		target = <&usb_dp_selector>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@36 {
		target = <&i2c6>;

		__overlay__ {

			spk1: speaker_amp@5c {
				compatible = "richtek,rt5512";
				#sound-dai-cells = <0x00>;
				reg = <0x5c>;
				status = "okay";
				sound-name-prefix = "Left";
				phandle = <0x30>;
			};

			spk2: speaker_amp@5d {
				compatible = "richtek,rt5512";
				#sound-dai-cells = <0x00>;
				reg = <0x5d>;
				status = "okay";
				sound-name-prefix = "Right";
				phandle = <0x31>;
			};
		};
	};

