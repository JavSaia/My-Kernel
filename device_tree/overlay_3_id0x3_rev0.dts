	fragment@12 {
		target = <&mtkfb>;

		__overlay__ {
			pinctrl-names = "lcd_bias_enp1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enn1_gpio", "lcd_bias_enn0_gpio", "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te", "lcm_led_en1_gpio", "lcm_led_en0_gpio", "mode_te_te1";
			pinctrl-0 = <&mtkfb_pins_lcd_bias_enp1>;
			pinctrl-1 = <&mtkfb_pins_lcd_bias_enp0>;
			pinctrl-2 = <&mtkfb_pins_lcd_bias_enn1>;
			pinctrl-3 = <&mtkfb_pins_lcd_bias_enn0>;
			pinctrl-4 = <&mtkfb_pins_lcm_rst_out1_gpio>;
			pinctrl-5 = <&mtkfb_pins_lcm_rst_out0_gpio>;
			pinctrl-6 = <&mtkfb_pins_lcm_dsi_te>;
			pinctrl-7 = <&mtkfb_pins_lcm_led_en1>;
			pinctrl-8 = <&mtkfb_pins_lcm_led_en0>;
			pinctrl-9 = <&mtkfb_pins_lcm_dsi1_te>;
			status = "okay";
		};
	};

	fragment@13 {
		target = <&dispsys_config>;

		__overlay__ {
			pinctrl-names = "mode_te_te", "mode_te_te1";
			pinctrl-0 = <&mtkfb_pins_lcm_dsi_te>;
			pinctrl-1 = <&mtkfb_pins_lcm_dsi1_te>;
			status = "okay";
		};
	};

	fragment@14 {
		target = <&pcie0>;

		__overlay__ {
			pinctrl-names = "default", "sleep", "work";
			pinctrl-0 = <&pcie0_pins_default>;
			pinctrl-1 = <&pcie0_pins_sleep>;
			pinctrl-2 = <&pcie0_pins_work>;
			max-link-speed = <0x03>;
			status = "okay";
		};
	};

	fragment@15 {
		target = <&pcie1>;

		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&pcie1_pins_default>;
			status = "disabled";
		};
	};

	fragment@16 {
		target = <&pciephy0>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@17 {
		target = <&pciephy1>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@18 {
		target = <&pio>;

		__overlay__ {

			pcie0_pins_default: pcie0-default {
				phandle = <0x1f>;

				pins-cmd-dat {
					pinmux = <0x8f00>;
					output-low;
				};

				pins-cmd-dat1 {
					pinmux = <0x9100>;
					bias-pull-up;
					input-enable;
				};
			};

			pcie0_pins_work: pcie0-work {
				phandle = <0x21>;

				pins-cmd-dat {
					pinmux = <0x8f01 0x9101>;
					bias-pull-up;
				};
			};

			pcie0_pins_sleep: pcie0-sleep {
				phandle = <0x20>;

				pins-cmd-dat {
					pinmux = <0x8f00>;
					output-low;
				};

				pins-cmd-dat1 {
					pinmux = <0x9100>;
					bias-pull-up;
					input-enable;
				};
			};

			pcie1_pins_default: pcie1-default {
				phandle = <0x22>;

				pins-cmd-dat {
					pinmux = <0x202 0x302 0x402>;
					bias-pull-up;
				};
			};
		};
	};

	fragment@19 {
		target = <&pio>;

		__overlay__ {

			ps_enable: ps_enable {
				phandle = <0x2e>;

				pins_cmd_dat {
					pinmux = <0x6f00>;
					output-high;
				};
			};

			ps_disable: ps_disable {
				phandle = <0x2f>;

				pins_cmd_dat {
					pinmux = <0x6f00>;
					output-low;
				};
			};
		};
	};

	fragment@20 {
		target = <&mt6375>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@21 {
		target = <&spmi>;

		__overlay__ {

			mt6379: mt6379@e {
				compatible = "mediatek,mt6379";
				reg = <0x0e 0x00>;
				wakeup-source;
				interrupt-parent = <&pio>;
				interrupts = <0xaf 0x08>;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				#address-cells = <0x01>;
				phandle = <0x2c>;

				dbg {
					compatible = "mediatek,mt6379-dbg";
				};

				mt6379_adc: adc {
					compatible = "mediatek,mt6379-adc";
					#io-channel-cells = <0x01>;
					phandle = <0x23>;
				};

				mt6379_chg: chg {
					compatible = "mediatek,mt6379-charger";
					interrupts = <0x00 0x01 0x08 0x0b 0x12 0x13 0x17 0x1b 0x2a 0x1f 0x33 0x70 0x40 0x41 0x42 0x06 0x07 0x0a>;
					interrupt-names = "fl_pwr_rdy", "fl_detach", "fl_vbus_ov", "fl_chg_tout", "fl_aicc_done", "fl_pe_done", "fl_wdt", "fl_batpro_done", "int_chrdet_ext", "fl_bc12_dn", "adc_vbat_mon_ov", "usbid_evt", "otp0", "otp1", "otp2", "fl_bus_chg_rdy", "fl_wlin_chg_rdy", "fl_chg_sysov";
					io-channels = <&mt6379_adc>, <0x00>, <&mt6379_adc>, <0x01>, <&mt6379_adc>, <0x02>, <&mt6379_adc>, <0x03>, <&mt6379_adc>, <0x04>, <&mt6379_adc>, <0x05>, <&mt6379_adc>, <0x06>, <&mt6379_adc>, <0x07>, <&mt6379_adc>, <0x08>, <&mt6379_adc>, <0x0f>, <&mt6379_adc>, <0x0b>, <&mt6379_adc>, <0x12>, <&mt6379_adc>, <0x13>;
					chgdev-name = "primary_chg";
					chg-tmr = <0x14>;
					chg-tmr-en;
					ircmp-v = <0x1e>;
					ircmp-r = <0x05>;
					wdt-time = <0x01>;
					te-en;
					mivr = <0x432380>;
					aicr = <0x7a120>;
					ichg = <0x1e8480>;
					ieoc = <0x249f0>;
					cv = <0x401640>;
					vrec = <0x186a0>;
					chgin-ov = <0x06>;
					bc12-sel = <0x00>;
					nr-port = <0x01>;
					boot-mode = <&chosen>;
					phys = <&u2port0>, <0x03>;
					phy-names = "usb2-phy";
					usb = <&ssusb>;
					pmic-uvlo = <&mt6363_dynamic_loading_throttling>;
					otg-supply = <&mt6379_otg_vbus>;
					support_icl_optimization;
					phandle = <0x28>;

					mt6379_otg_vbus: usb-otg-vbus-regulator {
						regulator-name = "mt6379-usb-otg-vbus";
						regulator-min-microvolt = <0x4a0150>;
						regulator-max-microvolt = <0x53ec60>;
						regulator-min-microamp = <0x7a120>;
						regulator-max-microamp = <0x27ac40>;
						phandle = <0x24>;
					};
				};

				regulator {
					compatible = "mediatek,mt6379-regulator";
					regulator-name = "mt6379-buckboost";
					regulator-min-microvolt = <0x1ee628>;
					regulator-max-microvolt = <0x4f5880>;
					regulator-allowed-modes = <0x00 0x01>;
					regulator-allow-bypass;
					regulator-always-on;
				};

				led-controller {
					compatible = "mediatek,mt6379-flash";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x4b 0x4d 0x4e 0x4f 0x52 0x53 0x54>;
					interrupt-names = "fled_lvf", "fled_bubo_vin_thro", "fled_thermal_thro", "fled_bubo_il_thro", "fled3_short", "fled2_short", "fled1_short";

					led@0 {
						reg = <0x00>;
						function = "flash";
						color = <0x00>;
						function-enumerator = <0x01>;
						led-max-microamp = <0x61a80>;
						flash-max-microamp = <0x16e360>;
						type = <0x00>;
						ct = <0x00>;
						part = <0x00>;

						port@0 {

							fl_core_0: endpoint {
								remote-endpoint = <&flashlight_0>;
								phandle = <0x91>;
							};
						};
					};

					led@1 {
						reg = <0x01>;
						function = "flash";
						color = <0x00>;
						function-enumerator = <0x02>;
						led-max-microamp = <0x61a80>;
						flash-max-microamp = <0x16e360>;
						type = <0x00>;
						ct = <0x01>;
						part = <0x00>;

						port@1 {

							fl_core_1: endpoint {
								remote-endpoint = <&flashlight_1>;
								phandle = <0x92>;
							};
						};
					};

					led@2 {
						reg = <0x02>;
						function = "flash";
						color = <0x00>;
						function-enumerator = <0x03>;
						led-max-microamp = <0x61a80>;
						flash-max-microamp = <0x16e360>;
						type = <0x00>;
						ct = <0x02>;
						part = <0x00>;

						port@2 {

							fl_core_2: endpoint {
								remote-endpoint = <&flashlight_2>;
								phandle = <0x93>;
							};
						};
					};
				};

				ufcs {
					compatible = "mediatek,mt6379-ufcs";
					interrupts = <0x7f>;
				};

				mt6379_typec: tcpc {
					compatible = "mediatek,mt6379-tcpc";
					interrupts = <0x78>;
					interrupt-names = "pd_evt";
					tcpc,name = "type_c_port0";
					tcpc,role-def = <0x01>;
					tcpc,rp-level = <0x00>;
					tcpc,vconn-supply = <0x01>;
					io-channels = <&mt6379_adc>, <0x0e>, <&mt6379_adc>, <0x0f>;
					charger = <&mt6379_chg>;
					tcpc,en-ctd;
					tcpc,en-typec-otp;
					tcpc,en-floatgnd;
					wd,sbu-calib-init = <0x4b0>;
					wd,sbu-pl-bound = <0xc8>;
					wd,sbu-pl-lbound-c2c = <0x44c>;
					wd,sbu-pl-ubound-c2c = <0xa28>;
					wd,sbu-ph-auddev = <0x64>;
					wd,sbu-ph-lbound = <0x378>;
					wd,sbu-ph-lbound1-c2c = <0xb22>;
					wd,sbu-ph-ubound1-c2c = <0xc4e>;
					wd,sbu-ph-ubound2-c2c = <0xed8>;
					wd,sbu-aud-ubound = <0x640>;
					wd,wd0-tsleep = <0x00>;
					wd,wd0-tdet = <0x03>;
					phandle = <0xec>;

					pd-data {
						pd,vid = <0x29cf>;
						pd,pid = <0x6379>;
						pd,source-cap-ext = [cf 29 79 63 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 07 00];
						pd,sink-cap-ext = <0xcf297963 0x00 0x100 0x00 0x10b010a 0xa000000>;
						pd,mfrs = "RichtekTCPC";
						pd,charging-policy = <0x00>;
						pd,source-pdo-size = <0x01>;
						pd,source-pdo-data = <0x19064>;
						pd,sink-pdo-size = <0x03>;
						pd,sink-pdo-data = <0x190c8 0x2d096 0xc0dc323c>;
						pd,id-vdo-size = <0x06>;
						pd,id-vdo-data = <0xd14029cf 0x00 0x63790000 0x61000000 0x00 0x41000000>;
						bat,nr = <0x01>;

						bat-info0 {
							bat,vid = <0x29cf>;
							bat,pid = <0x6379>;
							bat,mfrs = "bat1";
							bat,design-cap = <0xbb8>;
						};
					};

					dpm-caps {
						local-dr-power;
						local-dr-data;
						local-usb-comm;
						local-no-suspend;
						attempt-enter-dp-mode;
						pr-check = <0x00>;
						dr-check = <0x00>;
					};

					displayport {
						1st-connection = "dfp-d";
						2nd-connection = "dfp-d";
						typec,receptacle;

						ufp-d {
						};

						dfp-d {
							pin-assignment,mode-c;
							pin-assignment,mode-d;
							pin-assignment,mode-e;
						};
					};

					port {

						tcpc_typec_usb: endpoint {
							remote-endpoint = <&ssusb_mux>;
							phandle = <0x2d>;
						};
					};
				};

				mt6379_auxadc_1: auxadc {
					compatible = "mediatek,pmic-auxadc", "mediatek,mt6379-auxadc-1";
					interrupts = <0x6c>;
					interrupt-controller;
					#interrupt-cells = <0x01>;
					#address-cells = <0x01>;
					#io-channel-cells = <0x01>;
					io-channels = <&mt6379_adc>, <0x04>, <&mt6379_auxadc_1>, <0x05>;
					io-channel-names = "chg_vbat", "auxadc_vbat";
					charger = <&mt6379_chg>;
					gauge = <&mt6379_gauge>;
					isink-load-supply = <&mt6363_isink_load>;
					phandle = <0x2a>;

