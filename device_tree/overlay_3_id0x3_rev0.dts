	fragment@119 {
		target = <&pio>;

		__overlay__ {

			oplus_tp_spi_default: tp_spi_default {
				phandle = <0xa0>;

				pins_cmd_dat {
					pinmux = <0xe702 0xe802 0xe902 0xea02>;
					bias-disable;
					drive-strength = <0x04>;
				};
			};

			oplus_tp_int_active: tp_int_active {
				phandle = <0x9e>;

				pins_cmd_dat {
					pinmux = <0x600>;
					bias-disable;
					input-enable;
				};
			};

			oplus_tp_reset_active: tp_reset_active {
				phandle = <0x9f>;

				pins_cmd_data {
					pinmux = <0x300>;
					output-high;
				};
			};

			oplus_tp_suspend: tp_suspend {
				phandle = <0xa1>;

				pins_cmd_data {
					pinmux = <0x300 0x600>;
					output-low;
				};
			};

			oplus_tp_spi_suspend: tp_spi_suspend {
				phandle = <0xa2>;

				pins_cmd_data {
					pinmux = <0xe700 0xe800 0xe900 0xea00>;
					bias-disable;
					output-low;
				};
			};
		};
	};

	fragment@120 {
		target = <&keypad>;

		__overlay__ {
			keypad,volume-down = <&pio>, <0x0b 0x00>;
			pinctrl-names = "volume_down_as_int";
			pinctrl-0 = <&volume_down_gpio_eint>;
			status = "okay";
		};
	};

	fragment@121 {
		target = <&pio>;

		__overlay__ {

			volume_down_gpio_eint: volume_down@0 {
				phandle = <0xa3>;

				pins_cmd_dat {
					pinmux = <0xb00>;
					slew-rate = <0x00>;
					input-enable;
					bias-disable;
				};
			};
		};
	};

	fragment@122 {
		target = <&odm>;

		__overlay__ {

			kpd_volume_down: kpd_volume_down {
				compatible = "mediatek, VOLUME_DOWN-eint";
				interrupt-parent = <&pio>;
				interrupts = <0x0b 0x02 0x0b 0x00>;
				debounce = <0x7d00>;
				status = "okay";
				phandle = <0x12a>;
			};
		};
	};

	fragment@123 {
		target = <&odm>;

		__overlay__ {

			devinfo {
				status = "disabled";
			};

			devinfo_oplus {
				compatible = "oplus-devinfo";
				pinctrl-names = "default", "aboard_gpio0_sleep", "aboard_gpio0_active", "aboard_gpio0_idle";
				pinctrl-0 = <&hw_pins_default>;
				pinctrl-1 = <&aboard_pin_gpio0_sleep>;
				pinctrl-2 = <&aboard_pin_gpio0_active>;
				pinctrl-3 = <&aboard_pin_gpio0_idle>;

				main-sub {
					compatible = "hw-match, main-sub";
					use_tristate_gpio;
					aboard-gpio0 = <&pio>, <0x7e 0x00>;
					aboard-patterns = <0x00 0x00 0x00>;
					match-projects = <0x60ad 0x602e 0x60c1>;
				};
			};
		};
	};

	fragment@124 {
		target = <&pio>;

		__overlay__ {

			hw_pins_default: default@hw_sub_id {
				phandle = <0xa4>;
			};

			aboard_pin_gpio0_sleep: sleep@id0 {
				phandle = <0xa5>;

				pins_cmd_dat {
					pinmux = <0x7e00>;
					slew-rate = <0x00>;
					bias-pull-down = <0xc8>;
					input-enable;
				};
			};

			aboard_pin_gpio0_active: active@id0 {
				phandle = <0xa6>;

				pins_cmd_dat {
					pinmux = <0x7e00>;
					slew-rate = <0x00>;
					bias-pull-up = <0xc8>;
					input-enable;
				};
			};

			aboard_pin_gpio0_idle: idle@id0 {
				phandle = <0xa7>;

				pins_cmd_dat {
					pinmux = <0x7e00>;
					slew-rate = <0x00>;
					bias-disable;
					input-enable;
				};
			};
		};
	};

	fragment@125 {
		target = <&uart0>;

		__overlay__ {
			pinctrl-names = "uart0_rx_gpio", "uart0_tx_gpio";
			pinctrl-0 = <&uart0_rx_gpio_input>;
			pinctrl-1 = <&uart0_tx_gpio_input>;
			status = "okay";
			txpin = <0xcb>;
			rxpin = <0xcc>;
		};
	};

	fragment@126 {
		target = <&pio>;

		__overlay__ {

			uart0_rx_gpio_input: uart0_rx_gpio {
				phandle = <0xa8>;

