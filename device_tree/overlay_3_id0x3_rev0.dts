				};
			};

			mtkfb_pins_lcd_bias_enn0: lcd-bias-enn0-gpio {
				phandle = <0x18>;

				pins-cmd-dat {
					pinmux = <0xde00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_rst_out1_gpio: lcm-rst-out1-gpio {
				phandle = <0x19>;

				pins-cmd-dat {
					pinmux = <0x900>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_rst_out0_gpio: lcm-rst-out0-gpio {
				phandle = <0x1a>;

				pins-cmd-dat {
					pinmux = <0xe600>;
