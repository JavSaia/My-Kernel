			charging_inter_sleep: charging_inter_sleep {
				phandle = <0xc7>;

				pins_cmd_dat {
					pinmux = <0x5300>;
					input-enable;
					bias-pull-up;
				};
			};

			slave_charging_inter_active: slave_charging_inter_active {
				phandle = <0xcb>;

				pins_cmd_dat {
					pinmux = <0xc800>;
					input-enable;
					bias-pull-up;
				};
			};

			slave_charging_inter_sleep: slave_charging_inter_sleep {
				phandle = <0x12b>;

				pins_cmd_dat {
					pinmux = <0xc800>;
					input-enable;
					bias-pull-up;
				};
			};

			batt_sub_btb: batt_sub_btb {
				phandle = <0xb8>;

				pins_cmd_dat {
					pinmux = <0x5100>;
					input-enable;
					bias-pull-up;
				};
			};
		};
	};

