	fragment@53 {
		target = <&mt6373_vtp>;

		__overlay__ {
			regulator-boot-on;
			regulator-min-microvolt = <0x2ab980>;
			regulator-max-microvolt = <0x325aa0>;
		};
	};

	fragment@54 {
		target = <&pio>;

		__overlay__ {

			ctp_gt9896s_pins_default: pins-default {
				phandle = <0x58>;
			};

			ctp_gt9896s_int_active: int1-active {
				phandle = <0x59>;

				pins-cmd-dat {
					pinmux = <0x400>;
					input-enable;
				};
			};

			ctp_gt9896s_reset_active: reset1-active {
				phandle = <0x5a>;

				pins-cmd-dat {
					pinmux = <0x300>;
					output-high;
				};
			};

			ctp_gt9896s_int_suspend: int1-suspend {
				phandle = <0x5b>;

				pins-cmd-dat {
					pinmux = <0x400>;
					output-low;
				};
			};

			ctp_gt9896s_reset_suspend: reset1-suspend {
				phandle = <0x5c>;

				pins-cmd-dat {
					pinmux = <0x300>;
					output-low;
				};
			};

			ctp_gt9896s_spi_mode: spimode-default {
				phandle = <0x5d>;

				pins-cmd-dat {
					pinmux = <0xe702 0xe802 0xe902 0xea02>;
					drive-strength = <0x02>;
				};
			};

			ts_st_reset_active: ts-st-reset-active {
				phandle = <0x5e>;

				pins-cmd-dat {
					pinmux = <0x300>;
					output-high;
				};
			};

			ts_st_int_active: ts-st-int-active {
				phandle = <0x5f>;

				pins-cmd-dat {
					pinmux = <0x400>;
					input-enable;
				};
			};

			ts_st_int_suspend: ts-st-int-suspend {
				phandle = <0x60>;

				pins-cmd-dat {
					pinmux = <0x400>;
					slew-rate = <0x01>;
					bias-pull-down;
				};
			};

			ts_st_reset_suspend: ts-st-reset-suspend {
				phandle = <0x61>;

				pins-cmd-dat {
					pinmux = <0x300>;
					slew-rate = <0x01>;
					bias-pull-down;
				};
			};

			ts_st_spi_mode: ts-spimode {
				phandle = <0x62>;

				pins-cmd-dat {
					pinmux = <0xe702 0xe802 0xe902 0xea02>;
					drive-strength = <0x02>;
				};
			};
		};
	};

	fragment@55 {
		target = <&odm>;

		__overlay__ {

			tc8_touch: tc8-touch {
				compatible = "tc8sp-touch";
				status = "ok";
				touch,name = "tc8sp-touch";
				phandle = <0xef>;
			};
		};
	};

	fragment@56 {
		target = <&spi4>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			oplus_fp: fingerprint@0 {
				compatible = "oplus,fp_spi";
				reg = <0x00>;
				spi-max-frequency = <0x7a1200>;
				spi-id = <0x04>;
				spi-irq = <0xbb>;
				spi-reg = <0xa80f70>;
				uff,gpio_irq = <&pio>, <0xbb 0x00>;
				uff,gpio_reset = <&pio>, <0xbc 0x00>;
				uff,gpio_cs = <&pio>, <0xc0 0x00>;
				pinctrl-names = "default", "fp_spi_driver", "fp_cs_func";
				pinctrl-0 = <&gpio_uff_irq_default>, <&gpio_uff_reset_default>, <&gpio_uff_cs_default>;
				pinctrl-1 = <&gpio_uff_clk_6mA>, <&gpio_uff_mosi_6mA>, <&gpio_uff_miso_6mA>, <&gpio_uff_cs_6mA>;
				pinctrl-2 = <&gpio_uff_cs_func>;
				dvdd-supply = <&mt6373_vfp>;
				dvdd-config = <0x2dc6c0 0x2dc6c0 0x1d4c0>;
				optical_irq_disable_flag = <0x01>;
				power-num = <0x01>;
				status = "okay";
				phandle = <0xf0>;

				power_source_1 {
					power-mode = <0x01>;
					power-name = "dvdd";
					power-config = "dvdd-config";
					delay-time = <0x00>;
				};
			};
		};
	};

	fragment@57 {
		target = <&pio>;

		__overlay__ {

			gpio_uff_reset_default: gpio_uff_reset_default {
				phandle = <0x64>;

				pins_cmd_dat {
					pinmux = <0xbc00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			gpio_uff_irq_default: gpio_uff_irq_default {
				phandle = <0x63>;

				pins_cmd_dat {
					pinmux = <0xbb00>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
				};
			};

			gpio_uff_cs_default: gpio_uff_cs_default {
				phandle = <0x65>;

				pins_cmd_dat {
					pinmux = <0xc000>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
				};
			};

			gpio_uff_clk_6mA: gpio_uff_clk_6mA {
				phandle = <0x66>;

				pins_cmd_dat {
					pinmux = <0xbf02>;
					drive-strength = <0x01>;
				};
			};

			gpio_uff_mosi_6mA: gpio_uff_mosi_6mA {
				phandle = <0x67>;

				pins_cmd_dat {
					pinmux = <0xc102>;
					drive-strength = <0x02>;
				};
			};

			gpio_uff_miso_6mA: gpio_uff_miso_6mA {
				phandle = <0x68>;

				pins_cmd_dat {
					pinmux = <0xc202>;
					drive-strength = <0x01>;
				};
			};

			gpio_uff_cs_6mA: gpio_uff_cs_6mA {
				phandle = <0x69>;

				pins_cmd_dat {
					pinmux = <0xc002>;
					drive-strength = <0x02>;
				};
			};

			gpio_uff_cs_func: gpio_uff_cs_func {
				phandle = <0x6a>;

				pins_cmd_dat {
					pinmux = <0xc002>;
					drive-strength = <0x02>;
				};
			};
		};
	};

