					output-low;
				};
			};

			mtkfb_pins_lcm_dsi_te: lcm-dsi-te {
				phandle = <0x1b>;

				pins-cmd-dat {
					pinmux = <0xe501>;
				};
			};

			mtkfb_pins_lcm_led_en1: lcm-led-en1-gpio {
				phandle = <0x1c>;

				pins-cmd-dat {
					pinmux = <0xd700>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			mtkfb_pins_lcm_led_en0: lcm-led-en0-gpio {
				phandle = <0x1d>;

				pins-cmd-dat {
					pinmux = <0xd700>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			mtkfb_pins_lcm_dsi1_te: lcm-dsi1-te {
				phandle = <0x1e>;

				pins-cmd-dat {
					pinmux = <0xa01>;
				};
			};

			mtkfb_pins_lcm_dsi_gpio: lcm-dsi-gpio {
				phandle = <0xf7>;

				pins-cmd-dat {
					pinmux = <0xe500>;
				};
			};

			mtkfb_pins_lcm_dsi1_gpio: lcm-dsi1-gpio {
				phandle = <0xf8>;

				pins-cmd-dat {
					pinmux = <0xa00>;
				};
			};
