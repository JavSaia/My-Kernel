	fragment@136 {
		target = <&mtk_composite_v4l2_2>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				main_af_endpoint: endpoint {
					remote-endpoint = <&main_af>;
					phandle = <0x9f>;
				};
			};

			port@1 {
				reg = <0x01>;

				ois_power_endpoint: endpoint {
					remote-endpoint = <&ois_power>;
					phandle = <0xa0>;
				};
			};
		};
	};

	fragment@137 {
		target = <&i2c8>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;

			camera_af_main@0c {
				compatible = "oplus,dw9800s_24825";
				reg = <0x0c>;

				port {

					main_af: endpoint {
						remote-endpoint = <&main_af_endpoint>;
						phandle = <0x9d>;
					};
				};
			};

			camera_ois_power@33 {
				compatible = "oplus,ois_power";
				reg = <0x33>;
				ois1-supply = <&mt6373_vcn33_2>;

				port {

					ois_power: endpoint {
						remote-endpoint = <&ois_power_endpoint>;
						phandle = <0x9e>;
					};
				};
			};

			sensor0: sensor0@1a {
				compatible = "mediatek,imgsensor";
				sensor-names = "subarumain_mipi_raw";
				sensor-ids = <0x5112>;
				sensor-hal-names = "subarumain_mipi_raw";
				reg = <0x1a>;
				#thermal-sensor-cells = <0x00>;
				pinctrl-names = "mclk_off", "mclk_2mA", "mclk_4mA", "mclk_6mA", "mclk_8mA", "rst_low", "rst_high";
				pinctrl-0 = <&camera_pins_cam0_mclk_off>;
				pinctrl-1 = <&camera_pins_cam0_mclk_2ma>;
				pinctrl-2 = <&camera_pins_cam0_mclk_4ma>;
				pinctrl-3 = <&camera_pins_cam0_mclk_6ma>;
				pinctrl-4 = <&camera_pins_cam0_mclk_8ma>;
				pinctrl-5 = <&camera_pins_cam0_rst_0>;
				pinctrl-6 = <&camera_pins_cam0_rst_1>;
				avdd-supply = <&aw37004dnr_avdd1>;
				dvdd-supply = <&aw37004dnr_dvdd1>;
				afvdd-supply = <&mt6373_vcn33_1>;
				dovdd-supply = <&mt6373_vant18>;
				clocks = <&topckgen_clk>, <0xdc>, <&topckgen_clk>, <0xdb>, <&topckgen_clk>, <0xb4>, <&topckgen_clk>, <0xda>, <&topckgen_clk>, <0xd9>, <&topckgen_clk>, <0xd7>, <&topckgen_clk>, <0xd6>, <&topckgen_clk>, <0x56>;
				clock-names = "6", "12", "13", "19.2", "24", "26", "52", "mclk";
				status = "okay";
				phandle = <0xd8>;

				port {

					sensor0_out: endpoint {
						remote-endpoint = <&seninf_csi_port_3_in>;
						phandle = <0x9a>;
					};
				};
			};

			mtk_camera_eeprom0: camera-eeprom0@50 {
				compatible = "mediatek,camera_eeprom";
				reg = <0x50>;
				status = "okay";
				phandle = <0x13e>;
			};

			sensor4: sensor4@10 {
				compatible = "mediatek,imgsensor";
				sensor-names = "imx758_mipi_raw";
				reg = <0x10>;
				#thermal-sensor-cells = <0x00>;
				pinctrl-names = "mclk_off", "mclk_2mA", "mclk_4mA", "mclk_6mA", "mclk_8mA", "rst_low", "rst_high", "dvdd_off", "dvdd_on", "oisen_off", "oisen_on";
				pinctrl-0 = <&camera_pins_cam4_mclk_off>;
				pinctrl-1 = <&camera_pins_cam4_mclk_2ma>;
				pinctrl-2 = <&camera_pins_cam4_mclk_4ma>;
				pinctrl-3 = <&camera_pins_cam4_mclk_6ma>;
				pinctrl-4 = <&camera_pins_cam4_mclk_8ma>;
				pinctrl-5 = <&camera_pins_cam4_rst_0>;
				pinctrl-6 = <&camera_pins_cam4_rst_1>;
				pinctrl-7 = <&camera_pins_cam4_dvdd_0>;
				pinctrl-8 = <&camera_pins_cam4_dvdd_1>;
				pinctrl-9 = <&camera_pins_cam4_oisen_0>;
				pinctrl-10 = <&camera_pins_cam4_oisen_1>;
				avdd-supply = <&rt5133_ldo3>;
				afvdd-supply = <&rt5133_ldo2>;
				oisvdd-supply = <&rt5133_ldo1>;
				clocks = <&topckgen_clk>, <0xdc>, <&topckgen_clk>, <0xdb>, <&topckgen_clk>, <0xb4>, <&topckgen_clk>, <0xda>, <&topckgen_clk>, <0xd9>, <&topckgen_clk>, <0xd7>, <&topckgen_clk>, <0xd6>, <&topckgen_clk>, <0x54>;
				clock-names = "6", "12", "13", "19.2", "24", "26", "52", "mclk";
				status = "okay";
				phandle = <0xdb>;

				port {

					sensor4_out: endpoint {
						remote-endpoint = <&seninf_csi_port_0_in>;
						phandle = <0x97>;
					};
				};
			};
		};
	};

	fragment@138 {
		target = <&i2c9>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0xf4240>;

			sensor1: sensor1@10 {
				compatible = "mediatek,imgsensor";
				sensor-names = "subarufront_mipi_raw";
				sensor-ids = <0x4d01>;
				sensor-hal-names = "subarufront_mipi_raw";
				reg = <0x10>;
				#reindex-to = <0x00>;
				#cust-aov-csi-clk = <0x138>;
				#thermal-sensor-cells = <0x00>;
				pinctrl-names = "mclk1_off", "mclk1_2mA", "mclk1_4mA", "mclk1_6mA", "mclk1_8mA", "rst_low", "rst_high";
				pinctrl-0 = <&camera_pins_cam1_mclk_off>;
