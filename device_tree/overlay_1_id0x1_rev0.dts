			bat1-thd-volts-h = <0xdac 0xd48 0xc4e 0xe10 0xdac 0xcb2 0xe74 0xe10 0xd16 0xf0a 0xea6 0xdac>;
			lvsys-thd-volt-l = <0xb54>;
			lvsys-thd-volt-h = <0xc1c>;
			temperature-max-stage = <0x03>;
			temperature-stage-threshold = <0x19 0x0a 0x00>;
			bat0-aging-threshold = <0x3e8 0x7d0>;
			bat0-aging-volts-t0 = <0x00 0x00>;
			bat0-aging-volts-t1 = <0x00 0x00>;
			bat0-aging-volts-t2 = <0x00 0x00>;
			bat0-aging-volts-t3 = <0x00 0x00>;
			bat1-aging-threshold = <0x3e8 0x7d0>;
			bat1-aging-volts-t0 = <0x00 0x00>;
			bat1-aging-volts-t1 = <0x00 0x00>;
			bat1-aging-volts-t2 = <0x00 0x00>;
			bat1-aging-volts-t3 = <0x00 0x00>;
			throttle-level = <0x00 0x01 0x02 0x03 0x00 0x01 0x02 0x03 0x00 0x01 0x02 0x03 0x00 0x01 0x02 0x03>;
			bootmode = <&chosen>;
			gauge = <&mtk_gauge>;
		};
	};

	fragment@57 {
		target = <&cpu_power_throttling>;

		__overlay__ {
			compatible = "mediatek,cpu-power-throttling";
			lbat-max-level = <0x03>;
			lbat-limit-freq-lv1 = <0x1b7740 0x1b7740 0x10c8e0>;
			lbat-limit-freq-lv2 = <0x16e360 0x16e360 0xa3930>;
			lbat-limit-freq-lv3 = <0x50910 0x86470 0xa3930>;
			oc-max-level = <0x02>;
			oc-limit-freq-lv1 = <0x7fffffff 0x7fffffff 0x7fffffff>;
			oc-limit-freq-lv2 = <0x124f80 0x19f0a0 0x1cfde0>;
			soc-max-level = <0x01>;
			soc-limit-freq-lv1 = <0x7fffffff 0x7fffffff 0x7fffffff>;
		};
	};

	fragment@58 {
		target = <&gpu_power_throttling>;

		__overlay__ {
			compatible = "mediatek,gpu-power-throttling";
			lbat-max-level = <0x03>;
			lbat-limit-freq = <0x52850 0x52850 0x52850>;
			oc-max-level = <0x02>;
			oc-limit-freq = <0xef808 0x86470>;
			soc-max-level = <0x01>;
			soc-limit-freq = <0x7fffffff>;
		};
	};

	fragment@59 {
		target = <&bp_thl>;

		__overlay__ {
			compatible = "mediatek,mtk-bp-thl";
			max-throttle-level = <0x02>;
			soc-throttle-level = <0x00 0x01>;
			soc-max-stage = <0x01>;
			soc-limit-threshold = <0x0f>;
		};
	};

