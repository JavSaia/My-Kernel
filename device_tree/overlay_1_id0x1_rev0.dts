	fragment@102 {
		target = <&pio>;

		__overlay__ {

			oplus_tp_spi_default: tp_spi_default {
				phandle = <0x8d>;

				pins_cmd_dat {
					pinmux = <0xe702 0xe802 0xe902 0xea02>;
					bias-disable;
					drive-strength = <0x04>;
				};
			};

			oplus_tp_int_active: tp_int_active {
				phandle = <0x8b>;

				pins_cmd_dat {
					pinmux = <0x600>;
					input-enable;
				};
			};

			oplus_tp_reset_active: tp_reset_active {
				phandle = <0x8c>;

				pins_cmd_data {
					pinmux = <0x300>;
					output-high;
				};
			};

			oplus_tp_suspend: tp_suspend {
				phandle = <0x8e>;

				pins_cmd_data {
					pinmux = <0x300 0x600>;
					output-low;
				};
			};

			oplus_tp_spi_suspend: tp_spi_suspend {
				phandle = <0x8f>;

				pins_cmd_data {
					pinmux = <0xe700 0xe800 0xe900 0xea00>;
					bias-disable;
					output-low;
				};
			};
		};
	};

	fragment@103 {
		target = <&keypad>;

		__overlay__ {
			keypad,volume-down = <&pio>, <0x0b 0x00>;
			pinctrl-names = "volume_down_as_int";
			pinctrl-0 = <&volume_down_gpio_eint>;
			status = "okay";
		};
	};

	fragment@104 {
		target = <&pio>;

		__overlay__ {

			volume_down_gpio_eint: volume_down@0 {
				phandle = <0x90>;

				pins_cmd_dat {
					pinmux = <0xb00>;
					slew-rate = <0x00>;
					input-enable;
					bias-disable;
				};
			};
		};
	};

	fragment@105 {
		target = <&odm>;

		__overlay__ {

			kpd_volume_down: kpd_volume_down {
				compatible = "mediatek, VOLUME_DOWN-eint";
				interrupt-parent = <&pio>;
				interrupts = <0x0b 0x02 0x0b 0x00>;
				debounce = <0x7d00>;
				status = "okay";
				phandle = <0x132>;
			};
		};
	};

	fragment@106 {
		target = <&odm>;

		__overlay__ {

			devinfo {
				status = "disabled";
			};

			devinfo_oplus {
				compatible = "oplus-devinfo";
				pinctrl-names = "default", "aboard_gpio0_sleep", "aboard_gpio0_active", "aboard_gpio0_idle";
				pinctrl-0 = <&hw_pins_default>;
				pinctrl-1 = <&aboard_pin_gpio0_sleep>;
				pinctrl-2 = <&aboard_pin_gpio0_active>;
				pinctrl-3 = <&aboard_pin_gpio0_idle>;

				main-sub {
					compatible = "hw-match, main-sub";
					use_tristate_gpio;
					aboard-gpio0 = <&pio>, <0x7e 0x00>;
					aboard-patterns = <0x00>;
					match-projects = <0x60f9>;
				};
			};
		};
	};

	fragment@107 {
		target = <&pio>;

		__overlay__ {

			hw_pins_default: default@hw_sub_id {
				phandle = <0x91>;
			};

			aboard_pin_gpio0_sleep: sleep@id0 {
				phandle = <0x92>;

				pins_cmd_dat {
					pinmux = <0x7e00>;
					slew-rate = <0x00>;
					bias-pull-down = <0xc8>;
					input-enable;
				};
			};

			aboard_pin_gpio0_active: active@id0 {
				phandle = <0x93>;

				pins_cmd_dat {
					pinmux = <0x7e00>;
					slew-rate = <0x00>;
					bias-pull-up = <0xc8>;
					input-enable;
				};
			};

			aboard_pin_gpio0_idle: idle@id0 {
				phandle = <0x94>;

				pins_cmd_dat {
					pinmux = <0x7e00>;
					slew-rate = <0x00>;
					bias-disable;
					input-enable;
				};
			};
		};
	};

	fragment@108 {
		target = <&gpio_usage_mapping>;

		__overlay__ {
			GPIO-FDD-BAND-SUPPORT-DETECT-1ST-PIN = <&pio>, <0x28 0x00>;
			GPIO-FDD-BAND-SUPPORT-DETECT-2ND-PIN = <&pio>, <0x29 0x00>;
			GPIO-FDD-BAND-SUPPORT-DETECT-3RD-PIN = <&pio>, <0x2a 0x00>;
			GPIO-FDD-BAND-SUPPORT-DETECT-4TH-PIN = <&pio>, <0x2b 0x00>;
			GPIO-SIM1-HOT-PLUG = <&pio>, <0xd4 0x00>;
			GPIO-SIM2-HOT-PLUG = <&pio>, <0xd5 0x00>;
			GPIO-SIM1-SCLK = <&pio>, <0xef 0x00>;
			GPIO-SIM1-SRST = <&pio>, <0xf0 0x00>;
			GPIO-SIM1-SIO = <&pio>, <0xf1 0x00>;
			GPIO-SIM2-SCLK = <&pio>, <0xf2 0x00>;
			GPIO-SIM2-SRST = <&pio>, <0xf3 0x00>;
			GPIO-SIM2-SIO = <&pio>, <0xf4 0x00>;
		};
	};

