	fragment@10 {
		target = <&pdc>;

		__overlay__ {
			pd-vbus-upper-bound = <0x895440>;
		};
	};

	fragment@11 {
		target = <&pio>;

		__overlay__ {

			mtkfb_pins_lcd_bias_enp1: lcd-bias-enp1-gpio {
				phandle = <0x15>;

				pins-cmd-dat {
					pinmux = <0xde00>;
					slew-rate = <0x01>;
