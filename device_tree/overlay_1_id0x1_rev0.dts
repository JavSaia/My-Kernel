	fragment@61 {
		target = <&spi4>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			oplus_fp: fingerprint@0 {
				compatible = "oplus,fp_spi";
				reg = <0x00>;
				spi-max-frequency = <0x7a1200>;
				spi-id = <0x04>;
				spi-irq = <0xbb>;
				spi-reg = <0xa80f70>;
				uff,gpio_irq = <&pio>, <0xbb 0x00>;
				uff,gpio_reset = <&pio>, <0xbc 0x00>;
				uff,gpio_cs = <&pio>, <0xc0 0x00>;
				pinctrl-names = "default", "fp_spi_driver", "fp_cs_func";
				pinctrl-0 = <&gpio_uff_irq_default>, <&gpio_uff_reset_default>, <&gpio_uff_cs_default>;
				pinctrl-1 = <&gpio_uff_clk_6mA>, <&gpio_uff_mosi_6mA>, <&gpio_uff_miso_6mA>, <&gpio_uff_cs_6mA>;
				pinctrl-2 = <&gpio_uff_cs_func>;
				dvdd-supply = <&mt6373_vfp>;
				dvdd-config = <0x2dc6c0 0x2dc6c0 0x1d4c0>;
				optical_irq_disable_flag = <0x01>;
				power-num = <0x01>;
				status = "okay";
				phandle = <0xfd>;

				power_source_1 {
					power-mode = <0x01>;
					power-name = "dvdd";
					power-config = "dvdd-config";
					delay-time = <0x00>;
				};
			};
		};
	};

	fragment@62 {
		target = <&pio>;

		__overlay__ {

			gpio_uff_reset_default: gpio_uff_reset_default {
				phandle = <0x64>;

				pins_cmd_dat {
					pinmux = <0xbc00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			gpio_uff_irq_default: gpio_uff_irq_default {
				phandle = <0x63>;

				pins_cmd_dat {
					pinmux = <0xbb00>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
				};
			};

			gpio_uff_cs_default: gpio_uff_cs_default {
				phandle = <0x65>;

				pins_cmd_dat {
					pinmux = <0xc000>;
					slew-rate = <0x01>;
					bias-disable;
					output-low;
				};
			};

			gpio_uff_clk_6mA: gpio_uff_clk_6mA {
				phandle = <0x66>;

				pins_cmd_dat {
					pinmux = <0xbf02>;
					drive-strength = <0x02>;
				};
			};

			gpio_uff_mosi_6mA: gpio_uff_mosi_6mA {
				phandle = <0x67>;

				pins_cmd_dat {
					pinmux = <0xc102>;
					drive-strength = <0x02>;
				};
			};

			gpio_uff_miso_6mA: gpio_uff_miso_6mA {
				phandle = <0x68>;

				pins_cmd_dat {
					pinmux = <0xc202>;
					drive-strength = <0x01>;
				};
			};

			gpio_uff_cs_6mA: gpio_uff_cs_6mA {
				phandle = <0x69>;

				pins_cmd_dat {
					pinmux = <0xc002>;
					drive-strength = <0x02>;
				};
			};

			gpio_uff_cs_func: gpio_uff_cs_func {
				phandle = <0x6a>;

				pins_cmd_dat {
					pinmux = <0xc002>;
					drive-strength = <0x02>;
				};
			};
		};
	};

	fragment@63 {
		target = <&odm>;

		__overlay__ {

			sensor_fb: sensor_fb {
				compatible = "oplus,sensor-feedback";
				phandle = <0xfe>;
			};

			consumer_ir_core: consumer_ir_core {
				compatible = "oplus,kookong_ir_core";
				status = "okay";
				vdd-supply = <&mt6373_vmch>;
				vdd-min-vol = <0x2ab980>;
				vdd-max-vol = <0x2ab980>;
				phandle = <0xff>;
			};

			consumerIr: consumerIr {
				compatible = "oplus,kookong_ir_pwm";
				status = "okay";
				pwm-num = <0x00>;
				pwm-dma-mask = <0x40>;
				phandle = <0x100>;
			};

			ssc_interactive: ssc_interactive {
				report_brightness = <0x01>;
				support_pwm_turbo = <0x01>;
				support_bri_to_scp = <0x01>;
				need_to_sync_lcd_rate = <0x00>;
				report_blank_mode = <0x01>;
				phandle = <0x101>;
			};

			oplus_sensor: oplus_sensor {
				compatible = "oplus,sensor-devinfo";
				als-row-coe = <0x3e8>;
				phandle = <0x102>;

				gsensor_1: gsensor_1 {
					status = "okay";
					sensor_name = <0x10>;
					device_name = "icm456xy";
					i2c_num = <0x01>;
					direction = <0x03>;
					eint_num = <0x1b>;
					gyro_cali_version = <0x02>;
					gyro_cali_range = <0x15e>;
					acc_cali_range = <0x12c 0x12c 0x12c>;
					phandle = <0x103>;
				};

				msensor_1: msensor_1 {
					status = "okay";
					sensor_name = <0x02>;
					device_name = "mmc5603";
					i2c_num = <0x00>;
					i2c_addr = <0x30>;
					direction = <0x05>;
					eint_num = <0x00>;
					alg_flag = <0x02>;
					soft-mag-parameter = <0x26e0 0x00 0x3d5 0x00 0x0c 0x01 0x4c5 0x00 0x2470 0x00 0xed 0x01 0x58 0x00 0xcb 0x01 0x2a3a 0x00>;
					phandle = <0x104>;
				};

				proximity_1: proximity_1 {
					status = "okay";
					sensor_name = <0x11>;
					i2c_num = <0x00>;
					i2c_addr = <0x48>;
					direction = <0x04>;
					eint_num = <0x12>;
					low_step = <0x96>;
					high_step = <0xc8>;
					low_limit = <0x15e>;
					high_limit = <0x1c2>;
					dirty_low_step = <0x12c>;
					dirty_high_step = <0x190>;
					ps_dirty_limit = <0x708>;
					ps_ir_limit = <0x7d0>;
					ps_adjust_min = <0x00>;
					ps_adjust_max = <0x73a>;
					sampling_count = <0x05>;
					step_max = <0x190>;
					step_min = <0x50>;
					step_div = <0x7d0>;
					anti_shake_delta = <0x46>;
					dynamic_cali_max = <0x7d0>;
					raw2offset_radio = <0x3e8>;
					offset_max = <0xea60>;
					offset_range_min = <0x00>;
					offset_range_max = <0xfffe>;
					force_cali_limit = <0x7d0>;
					cali_jitter_limit = <0x14>;
					cal_offset_margin = <0xbb8>;
					parameter-number = <0x06>;
					sensor-reg = <0x05 0x20 0x02 0x73 0x03 0x3c>;
					phandle = <0x105>;
				};

				light_1: light_1 {
					status = "okay";
					sensor_name = <0x11>;
					i2c_num = <0x00>;
					i2c_addr = <0x48>;
					direction = <0x04>;
					eint_num = <0x12>;
					als_buffer_length = <0x04>;
					als_type = <0x02>;
					device_name = "stk6a7x";
					coefficient_mode = <0x01>;
					als_coef_a = <0x2472>;
					als_coef_b = <0xae7e>;
					als_coef_c = <0x848>;
					als_coef_d = <0x19c8>;
					als_coef_e = <0x2328>;
					als_coef_ratio = <0x32>;
					phandle = <0x106>;
				};

				als_panel_P_3_1: als_panel_P_3_1 {
					status = "okay";
					device_name = "stk63701";
					support_panel = <0x07>;
					als_ratio = <0x21d>;
					phandle = <0x107>;
				};

				als_panel_P_7_1: als_panel_P_7_1 {
					status = "okay";
					device_name = "stk63701";
					support_panel = <0x0c>;
					als_ratio = <0x19a>;
					phandle = <0x108>;
				};

				pick_up: pick_up {
					status = "okay";
					use-proximity = <0x01>;
					phandle = <0x109>;
				};

