	fragment@91 {
		target = <&odm>;

		__overlay__ {

			oplus_project: oplus_project {
				compatible = "oplus,oplus_project";
				phandle = <0x128>;
			};

			pmic_history_count: pmic_history_count {
				phandle = <0x129>;
			};

			pmic_history0: pmic_history0 {
				phandle = <0x12a>;
			};

			pmic_history1: pmic_history1 {
				phandle = <0x12b>;
			};

			pmic_history2: pmic_history2 {
				phandle = <0x12c>;
			};

			pmic_history3: pmic_history3 {
				phandle = <0x12d>;
			};
		};
	};

	fragment@92 {
		target = <&mobicore>;

		__overlay__ {
			trustonic,real-drv = <0x01>;
		};
	};

	fragment@93 {
		target = <&oplus_secure_common>;

		__overlay__ {
			compatible = "oplus,secure_common";
			oplus,sec_reg_num = <0x00>;
			oplus,sec_en_anti_reg = <0x00>;
			oplus,sec_override1_reg = <0x00>;
			oplus,override1_en_value = <0x00>;
		};
	};

	fragment@94 {
		target = <&pio>;

		__overlay__ {

			swtp: swtp {
				compatible = "mediatek, swtp-eint";
				interrupt-parent = <&pio>;
				interrupts = <0x04 0x04>;
				deb-gpios = <&pio>, <0x04 0x00>;
				debounce = <0x7d000>;
				status = "okay";
				phandle = <0x12e>;
			};

			swtp_1: swtp_1 {
				compatible = "mediatek, swtp1-eint";
				phandle = <0x12f>;
			};
		};
	};

	fragment@95 {
		target = <&odm>;

		__overlay__ {

			oplus_sim_detect {
				compatible = "oplus, sim_detect";
				Hw,sim_det = <&pio>, <0xd4 0x00>;
			};
		};
	};

	fragment@96 {
		target = <&mtkheap_region_svp>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@97 {
		target = <&mtkheap_region_wfd>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@98 {
		target = <&mtee_svp>;

		__overlay__ {

			mtee: MTEE {
				compatible = "mediatek,mtk_svp_on_mtee_support";
				phandle = <0x130>;
			};

			svp: SecureVideoPath {
				compatible = "mediatek,mtk_sec_video_path_support";
				phandle = <0x131>;
			};
		};
	};

	fragment@99 {
		target = <&soc>;

		__overlay__ {

			oplus,blk-mq {
				block_graded_thread_enable = "y";
			};

			oplus_binder_sched {
				thread_full_boost_task = <0x01>;
			};
		};
	};

	fragment@100 {
		target = <&mt6363keys>;

		__overlay__ {
			compatible = "mediatek,mt6363-keys";
			mediatek,long-press-mode = <0x02>;
			power-off-time-sec = <0x00>;
		};
	};

