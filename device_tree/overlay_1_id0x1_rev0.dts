		target = <&afe>;

		__overlay__ {
			etdm-iv-latch-point = <0x04>;
		};
	};

	fragment@130 {
		target = <&i2c10>;

		__overlay__ {
			clock-frequency = <0x61a80>;

			aw37004dnr@28 {
				compatible = "aw37004dnr-pmic";
				reg = <0x28>;

				regulators {

					aw37004dnr_dvdd1: ONLDO1 {
						regulator-name = "aw37004dnr_dvdd1";
						regulator-min-microvolt = <0x927c0>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0xa9>;
					};

					aw37004dnr_dvdd2: ONLDO2 {
						regulator-name = "aw37004dnr_dvdd2";
						regulator-min-microvolt = <0x927c0>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0xbf>;
					};

					aw37004dnr_avdd1: ONLDO3 {
						regulator-name = "aw37004dnr_avdd1";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x419ce0>;
						phandle = <0xa8>;
					};

					aw37004dnr_avdd2: ONLDO4 {
						regulator-name = "aw37004dnr_avdd2";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x419ce0>;
						phandle = <0xbe>;
					};
				};
			};
		};
	};

	fragment@131 {
