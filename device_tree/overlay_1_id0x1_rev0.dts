	fragment@53 {
		target = <&mt6373_vtp>;

		__overlay__ {
			regulator-boot-on;
			regulator-min-microvolt = <0x2ab980>;
			regulator-max-microvolt = <0x325aa0>;
		};
	};

	fragment@54 {
		target = <&pio>;

		__overlay__ {

			ctp_gt9896s_pins_default: pins-default {
				phandle = <0x58>;
			};

			ctp_gt9896s_int_active: int1-active {
				phandle = <0x59>;

				pins-cmd-dat {
					pinmux = <0x400>;
					input-enable;
				};
			};

			ctp_gt9896s_reset_active: reset1-active {
				phandle = <0x5a>;

				pins-cmd-dat {
					pinmux = <0x300>;
					output-high;
				};
			};

			ctp_gt9896s_int_suspend: int1-suspend {
				phandle = <0x5b>;

				pins-cmd-dat {
					pinmux = <0x400>;
					output-low;
				};
			};

			ctp_gt9896s_reset_suspend: reset1-suspend {
				phandle = <0x5c>;

				pins-cmd-dat {
					pinmux = <0x300>;
					output-low;
				};
			};

			ctp_gt9896s_spi_mode: spimode-default {
				phandle = <0x5d>;

				pins-cmd-dat {
					pinmux = <0xe702 0xe802 0xe902 0xea02>;
					drive-strength = <0x02>;
				};
			};

			ts_st_reset_active: ts-st-reset-active {
				phandle = <0x5e>;

				pins-cmd-dat {
					pinmux = <0x300>;
					output-high;
				};
			};

			ts_st_int_active: ts-st-int-active {
				phandle = <0x5f>;

				pins-cmd-dat {
					pinmux = <0x400>;
					input-enable;
				};
			};

			ts_st_int_suspend: ts-st-int-suspend {
				phandle = <0x60>;

				pins-cmd-dat {
					pinmux = <0x400>;
					slew-rate = <0x01>;
					bias-pull-down;
				};
			};

			ts_st_reset_suspend: ts-st-reset-suspend {
				phandle = <0x61>;

				pins-cmd-dat {
					pinmux = <0x300>;
					slew-rate = <0x01>;
					bias-pull-down;
				};
			};

			ts_st_spi_mode: ts-spimode {
				phandle = <0x62>;

				pins-cmd-dat {
					pinmux = <0xe702 0xe802 0xe902 0xea02>;
					drive-strength = <0x02>;
				};
			};
		};
	};

	fragment@55 {
		target = <&odm>;

		__overlay__ {

			tc8_touch: tc8-touch {
				compatible = "tc8sp-touch";
				status = "ok";
				touch,name = "tc8sp-touch";
				phandle = <0xfc>;
			};
		};
	};

	fragment@56 {
		target = <&low_battery_throttling>;

		__overlay__ {
			compatible = "mediatek,low_battery_throttling";
			pt-shutdown-enable = <0x00>;
			lvsys-thd-enable = <0x01>;
			vbat-thd-enable = <0x01>;
			bat0-thd-volts-l = <0xd48 0xc4e 0xb54 0xdac 0xcb2 0xbb8 0xe10 0xd16 0xc1c 0xea6 0xdac 0xcb2>;
